# Polish month abbreviations for bank statement PDF parsing.
# Used by PKO BP, ING, mBank, Santander, BNP Paribas, Pekao, and others.
#
# Convention:
#   month-{N} = primary abbreviation used by this locale
#       .alt   = additional accepted spelling (repeat for more)
#
# Note: "paź" contains a diacritic that some PDF text extractors drop.
# Both spellings are listed so either form is accepted.

month-1 = sty
month-2 = lut
month-3 = mar
month-4 = kwi
month-5 = maj
month-6 = cze
month-7 = lip
month-8 = sie
month-9 = wrz
month-10 = paz
    .alt = paź
month-11 = lis
month-12 = gru
