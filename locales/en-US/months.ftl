# English month abbreviations for bank statement PDF parsing.
#
# Convention:
#   month-{N} = primary abbreviation used by this locale
#       .alt   = additional accepted spelling (repeat for more)
#
# N matches the calendar month number (1 = January … 12 = December).

month-1 = jan
month-2 = feb
month-3 = mar
month-4 = apr
month-5 = may
month-6 = jun
month-7 = jul
month-8 = aug
month-9 = sep
    .alt = sept
month-10 = oct
month-11 = nov
month-12 = dec
