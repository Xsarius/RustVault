## Budget locale strings for RustVault backend (Fluent)

budget-not-found = Budget not found.
budget-line-not-found = Budget line not found.
budget-period-invalid = Period end must be after period start.
budget-currency-required = Currency code is required.
budget-name-required = Budget name is required.
budget-copy-name-required = A name is required for the copied budget.

budget-created = Budget "{ $name }" created successfully.
budget-updated = Budget "{ $name }" updated.
budget-deleted = Budget "{ $name }" deleted.
budget-archived = Budget "{ $name }" archived.
budget-unarchived = Budget "{ $name }" restored from archive.
budget-copied = Budget copied as "{ $name }".

budget-line-added = Budget line added.
budget-line-updated = Budget line updated.
budget-line-deleted = Budget line removed.
budget-lines-bulk-set = Budget lines replaced ({ $count } lines set).

budget-actuals-refreshed = Actual amounts refreshed for "{ $name }".

