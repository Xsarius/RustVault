# Report messages
# Project Fluent format — https://projectfluent.org/

# Endpoint errors
report-summary-failed = Failed to generate the dashboard summary.
report-income-expense-failed = Failed to generate the income vs. expense report.
report-category-trend-not-found = Category { $id } was not found or does not belong to you.
report-category-trend-failed = Failed to generate the category trend report.
report-balance-history-failed = Failed to generate the balance history report.
report-cash-flow-failed = Failed to generate the cash flow report.

# Date range validation
report-date-range-invalid = The date range is invalid: "from" must be before or equal to "to".
report-date-range-too-wide = The date range may not exceed { $max_days } days.

# Account filter
report-account-not-found = Account { $id } was not found or does not belong to you.
