# ── Rust ─────────────────────────────────────────────────
# Compiled files and executables
debug/
target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC debugging information
*.pdb

# Cargo mutants output
**/mutants.out*/

# SQLx offline query data (generated, committed selectively)
# sqlx-data.json

# ── Frontend ─────────────────────────────────────────────
web/node_modules/
web/dist/
web/.vite/
web/.solid/
*.lockb

# ── Capacitor native platforms (generated, not committed) ─
web/android/
web/ios/

# ── Vite root-level cache (if accidentally run from root) ─
.vite/

# ── Environment & Secrets ────────────────────────────────
.env
.env.local
.env.*.local

# ── Docker ───────────────────────────────────────────────
docker-compose.override.yml

# ── IDE / Editor ─────────────────────────────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Documentation build output ───────────────────────────
docs/book/book/

# ── Vale style cache ────────────────────────────────────
.vale/
docs/adr/template.md
docs/wireframes/*.py
